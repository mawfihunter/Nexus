# GEMINI_API_KEY: Required for Gemini AI API calls and Natural Language / Voice Orchestration.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Dev and production HTTP port (Default 3000)
PORT=3000

# NEXUS_LOCAL_NODE_ID: Unique identifier for the primary PC compute node
NEXUS_LOCAL_NODE_ID="NEXUS-NODE-01-ULTRA9"

# NEXUS_ZERO_TRUST_TOKEN: Authentication token for companion agent pairing
NEXUS_ZERO_TRUST_TOKEN="nexus_sec_token_example_hash"
